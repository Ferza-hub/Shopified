{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "paths": {
      "@shopified/shared": ["../../packages/shared/src"],
      "@shopified/database": ["../../packages/database/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
