# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/shopified"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
API_PORT=3001
ADMIN_PORT=3000
STOREFRONT_PORT=3002
API_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3002"

# Storage (S3-compatible)
STORAGE_DRIVER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="shopified"
AWS_ENDPOINT=""

# Email
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@shopified.com"

# Stripe (payment gateway example)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
